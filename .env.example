# --- LLM (obligatorio) ---
# Credencial de Gemini. La persona revisora pone la suya.
GOOGLE_API_KEY=
# Identificador exacto del modelo (ej. gemini-3.6-flash).
GOOGLE_MODEL=gemini-3.6-flash

# --- MCP: CoinGecko (bono) ---
# Servidor MCP oficial, gratuito y sin API key.
MCP_URL=https://mcp.api.coingecko.com/mcp

# --- Debug ---
DEBUG=

# --- Servicio principal y especialista ---
CRIPTO_API_TOKEN=
ESPECIALISTA_A2A_URL=http://127.0.0.1:2024
# Opcional para el despliegue del especialista con API key de LangGraph.
ESPECIALISTA_API_TOKEN=

# --- Especialista A2A adicional en n8n (ampliación de +1,0) ---
# Webhook del workflow n8n/a2a-plan-dca.json. Si se deja vacío, la rama "plan"
# responde con un mensaje controlado y el resto del agente sigue funcionando.
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/a2a-plan

# Chat web. Usuarios fijos: usuario y admin.
WEB_USER_PASSWORD=
WEB_ADMIN_PASSWORD=
WEB_SESSION_SECRET=
# Usa 1 con HTTPS si el proxy no informa el esquema a Uvicorn.
WEB_SECURE_COOKIE=0
# Opcional: ruta al SQLite sobre un volumen persistente.
# WEB_HISTORY_DB=datos/historial_web.sqlite3

# --- Base de conocimiento del RAG ---
# "sqlite" no necesita servidor de base de datos (recomendado para desarrollar
# y para que el docente reproduzca). "postgres" usa pgvector (despliegue).
RAG_BACKEND=sqlite
# Corpus versionado en el repositorio. También acepta un PDF.
RAG_CORPUS=criptomonedas-desde-cero.md
# Índice generado por `python cargar_guia.py` cuando RAG_BACKEND=sqlite.
RAG_SQLITE_PATH=datos/indice_rag.sqlite3
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Solo se usa con RAG_BACKEND=postgres (pooler de Supabase o docker compose).
SUPABASE_DB_URL=
# 1 = indexar el corpus al arrancar si el índice local está vacío.
# Necesario en despliegues sin disco persistente (por ejemplo Render free).
RAG_AUTOCARGA=0

# --- Registro de ejecuciones ---
# Una línea JSON por solicitud. Se consulta con GET /registro/{solicitud_id}
# o se agrega con `python scripts/metricas.py`.
REGISTRO_PATH=datos/registros/ejecuciones.jsonl

# Historial persistente en Supabase e identidad IAM entre servicios Cloud Run.
WEB_HISTORY_POSTGRES=0
ESPECIALISTA_CLOUD_RUN_IAM=0
